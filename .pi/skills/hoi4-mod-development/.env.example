# Steam Workshop upload credentials
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# Steam username for SteamCMD login
STEAM_USER=your_steam_username

# Steam password
STEAM_PASS=your_steam_password

# Path to steamcmd.exe (optional, auto-detected)
# STEAMCMD_PATH=D:/SteamCMD/steamcmd.exe

# Workflow:
# 1. Fill in STEAM_USER and STEAM_PASS above
# 2. Run: python scripts/hoi4_workshop_upload.py
# 3. If Steam Guard mobile authenticator: confirm on phone
# 4. Upload completes after confirmation
#
# Note: Steam Guard mobile authenticator requires phone confirmation
# on EVERY login. This is normal Steam behavior.
# For full automation, use an account without mobile authenticator.
